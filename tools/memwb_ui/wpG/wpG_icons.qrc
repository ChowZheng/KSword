<RCC>
    <!-- WP-G 夹具专用的精简图标资源：别名与主程序 Ksword5.qrc 保持一致，只收录
         WorkbenchSessionBar/WorkbenchStatusBar/WriteModeSwitch/WorkbenchActions
         实际用到的别名，让离屏截图里的图标按钮不是空白方块。 -->
    <qresource prefix="/Icon">
        <file alias="process_main.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/system/process_line.svg</file>
        <file alias="process_refresh.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/system/refresh_3_line.svg</file>
        <file alias="memwb_mode_immediate.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/device/flash_line.svg</file>
        <file alias="memwb_mode_staged.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/file/inbox_line.svg</file>
        <file alias="service_apply.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/system/check_line.svg</file>
        <file alias="log_clear.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/system/delete_2_line.svg</file>
        <file alias="log_cancel_track.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/system/close_line.svg</file>
        <file alias="log_copy.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/file/copy_line.svg</file>
        <file alias="detail_node_collapsed.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/arrow/right_small_line.svg</file>
        <file alias="detail_node_expanded.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/arrow/down_small_line.svg</file>
        <file alias="file_nav_back.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/arrow/left_line.svg</file>
        <file alias="file_nav_forward.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/arrow/right_line.svg</file>
        <file alias="memwb_bookmarks.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/education/bookmarks_line.svg</file>
        <file alias="memwb_bookmark_add.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/education/bookmark_add_line.svg</file>
        <file alias="disk_tools.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/system/tool_line.svg</file>
        <file alias="memwb_tab_hex.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/editor/hashtag_line.svg</file>
        <file alias="memwb_tab_disasm.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/development/code_line.svg</file>
        <file alias="memwb_tab_text.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/editor/text_line.svg</file>
        <file alias="memwb_tab_compare.svg">../../../Ksword5.1/Ksword5.1/Resource/Icon/development/git_compare_line.svg</file>
    </qresource>
</RCC>
